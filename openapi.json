            }
          }
        }
      }
    },
    "/api/v1/search/knowledge": {
      "post": {
        "tags": [
          "Hybrid Retrieval"
        ],
        "summary": "Hybrid Knowledge Retrieval",
        "description": "Executes multi-stage hybrid search (Dense Vector + BM25 + RRF + Reranker) with access filtering.",
        "operationId": "search_knowledge_api_v1_search_knowledge_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchKnowledgeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchKnowledgeResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/qa/ask": {
      "post": {
        "tags": [
