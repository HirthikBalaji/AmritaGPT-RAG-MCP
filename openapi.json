  "components": {
    "schemas": {
      "AcademicRegulationsRequest": {
        "properties": {
          "query": {
            "type": "string",
            "title": "Query",
            "description": "Specific regulation clause, attendance, grading rule",
            "example": "R.14 grading system"
          },
          "program": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Program",
            "description": "Academic degree program",
            "default": "B.Tech",
            "example": "B.Tech"
          },
          "academic_year": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Academic Year",
            "description": "Admissions or regulation year",
            "default": "2023",
            "example": "2023"
          }
        },
        "type": "object",
        "required": [
          "query"
        ],
        "title": "AcademicRegulationsRequest"
      },
      "AskQuestionRequest": {
        "properties": {
          "question": {
            "type": "string",
            "title": "Question",
            "description": "Natural language question for institutional RAG",
            "example": "What is the minimum attendance required to appear for end semester examinations?"
          },
          "role": {
            "type": "string",
            "title": "Role",
            "description": "Role of the asking user",
            "default": "student",
            "example": "student"
          },
          "department": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Department",
            "description": "Optional target department",
            "example": "Academic Admin Office"
          }
        },
        "type": "object",
        "required": [
          "question"
        ],
        "title": "AskQuestionRequest"
      },
      "AskQuestionResponse": {
        "properties": {
          "question": {
            "type": "string",
            "title": "Question"
          },
          "answer": {
            "type": "string",
            "title": "Answer",
            "description": "Verified answer synthesized from institutional documents"
          },
          "confidence": {
            "type": "string",
            "title": "Confidence",
            "description": "'High', 'Moderate', 'Low', or 'None'",
            "example": "High"
          },
          "grounding_score": {
            "type": "number",
            "title": "Grounding Score",
            "description": "Factual alignment score between 0.0 and 1.0",
            "example": 0.95
          },
          "is_faithful": {
            "type": "boolean",
            "title": "Is Faithful",
            "description": "Flag indicating if the answer contains unsupported claims",
            "example": true
          },
          "intent": {
            "type": "string",
            "title": "Intent",
            "example": "Academic Regulation"
          },
          "citations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Citations",
            "description": "Formatted citations with document, section, and page provenance"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/SourceItem"
            },
            "type": "array",
            "title": "Sources"
          },
          "is_sufficient": {
            "type": "boolean",
            "title": "Is Sufficient",
            "description": "False if knowledge base lacked sufficient evidence"
          },
          "role": {
            "type": "string",
            "title": "Role"
          },
          "latency_ms": {
            "type": "number",
            "title": "Latency Ms",
            "example": 120.5
          }
        },
        "type": "object",
        "required": [
          "question",
          "answer",
          "confidence",
          "grounding_score",
          "is_faithful",
          "intent",
          "citations",
          "is_sufficient",
          "role",
          "latency_ms"
        ],
        "title": "AskQuestionResponse"
      },
      "CompareVersionsRequest": {
        "properties": {
          "doc_id_1": {
            "type": "string",
            "title": "Doc Id 1",
            "description": "ID of first/baseline document",
            "example": "doc_id_1"
          },
          "doc_id_2": {
            "type": "string",
            "title": "Doc Id 2",
            "description": "ID of second/comparative document",
            "example": "doc_id_2"
          },
          "topic": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Topic",
            "description": "Optional topic or course keyword to compare",
            "example": "machine learning"
          }
        },
        "type": "object",
        "required": [
          "doc_id_1",
          "doc_id_2"
        ],
        "title": "CompareVersionsRequest"
      },
      "CompareVersionsResponse": {
        "properties": {
          "doc_1": {
            "additionalProperties": true,
            "type": "object",
            "title": "Doc 1"
          },
          "doc_2": {
            "additionalProperties": true,
            "type": "object",
            "title": "Doc 2"
          },
          "comparison_topic": {
            "type": "string",
            "title": "Comparison Topic"
          }
        },
        "type": "object",
        "required": [
          "doc_1",
          "doc_2",
          "comparison_topic"
        ],
        "title": "CompareVersionsResponse"
      },
      "DocumentDetailResponse": {
        "properties": {
          "doc_id": {
            "type": "string",
            "title": "Doc Id"
          },
          "filename": {
            "type": "string",
            "title": "Filename"
          },
          "department": {
            "type": "string",
            "title": "Department"
          },
          "category": {
            "type": "string",
            "title": "Category"
          },
          "academic_year": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Academic Year"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "access_policy": {
            "type": "string",
            "title": "Access Policy"
          },
          "total_sections": {
            "type": "integer",
            "title": "Total Sections"
          },
          "sections": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Sections"
          }
        },
        "type": "object",
        "required": [
          "doc_id",
          "filename",
          "department",
          "category",
          "version",
          "access_policy",
          "total_sections"
        ],
        "title": "DocumentDetailResponse"
      },
      "DocumentSummary": {
        "properties": {
          "doc_id": {
            "type": "string",
            "title": "Doc Id",
            "example": "a1b2c3d4e5f6"
          },
          "filename": {
            "type": "string",
            "title": "Filename",
            "example": "curriculum-and-syllabi-amrita-btech-cse-2023.pdf"
          },
          "department": {
            "type": "string",
            "title": "Department",
            "example": "Academic Admin Office"
          },
          "category": {
            "type": "string",
            "title": "Category",
            "example": "Academic Programs & Regulations"
          },
          "academic_year": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Academic Year",
            "example": "2023"
          },
          "version": {
            "type": "string",
            "title": "Version",
            "example": "2023"
          },
          "access_policy": {
            "type": "string",
            "title": "Access Policy",
            "example": "student"
          },
          "sections": {
            "type": "integer",
            "title": "Sections",
            "example": 42
          }
        },
        "type": "object",
        "required": [
          "doc_id",
          "filename",
          "department",
          "category",
          "version",
          "access_policy",
          "sections"
        ],
        "title": "DocumentSummary"
      },
      "EvaluationMetricResponse": {
        "properties": {
          "total_benchmark_queries": {
            "type": "integer",
            "title": "Total Benchmark Queries",
            "example": 5
          },
          "recall_at_1": {
            "type": "number",
            "title": "Recall At 1",
            "example": 0.4
          },
          "recall_at_5": {
            "type": "number",
            "title": "Recall At 5",
            "example": 0.6
          },
          "mean_reciprocal_rank_mrr": {
            "type": "number",
            "title": "Mean Reciprocal Rank Mrr",
            "example": 0.5
          },
          "p50_latency_ms": {
            "type": "number",
            "title": "P50 Latency Ms",
            "example": 180.2
          },
          "p95_latency_ms": {
            "type": "number",
            "title": "P95 Latency Ms",
            "example": 245.0
          },
          "detailed_results": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Detailed Results"
          }
        },
        "type": "object",
        "required": [
          "total_benchmark_queries",
          "recall_at_1",
          "recall_at_5",
          "mean_reciprocal_rank_mrr",
          "p50_latency_ms",
          "p95_latency_ms"
        ],
        "title": "EvaluationMetricResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "PolicyRegulationResponse": {
        "properties": {
          "topic": {
            "type": "string",
            "title": "Topic"
          },
          "program": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Program"
          },
          "academic_year": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Academic Year"
          },
          "regulations_found": {
            "type": "integer",
            "title": "Regulations Found"
          },
          "evidence": {
            "type": "string",
            "title": "Evidence"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/SourceItem"
            },
            "type": "array",
            "title": "Sources"
          }
        },
        "type": "object",
        "required": [
          "topic",
          "regulations_found",
          "evidence"
        ],
        "title": "PolicyRegulationResponse"
      },
      "PolicySearchRequest": {
        "properties": {
          "query": {
            "type": "string",
            "title": "Query",
            "description": "Policy question or guideline keyword",
            "example": "hostel rules and curfew"
          },
          "role": {
            "type": "string",
            "title": "Role",
            "description": "User role for access control",
            "default": "student",
            "example": "student"
          }
        },
        "type": "object",
        "required": [
          "query"
        ],
        "title": "PolicySearchRequest"
      },
      "SearchDocumentsRequest": {
        "properties": {
          "query": {
            "type": "string",
            "title": "Query",
            "description": "Search keyword in filename, category, or department",
            "example": "regulations"
          },
          "department": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Department",
            "description": "Optional department filter",
            "example": "CSE"
          },
          "role": {
            "type": "string",
            "title": "Role",
            "description": "User role for permission filtering",
            "default": "student",
            "example": "student"
          }
        },
        "type": "object",
        "required": [
          "query"
        ],
        "title": "SearchDocumentsRequest"
      },
      "SearchDocumentsResponse": {
        "properties": {
          "query": {
            "type": "string",
            "title": "Query"
          },
          "total_matches": {
            "type": "integer",
            "title": "Total Matches"
          },
          "documents": {
            "items": {
              "$ref": "#/components/schemas/DocumentSummary"
            },
            "type": "array",
            "title": "Documents"
          }
        },
        "type": "object",
        "required": [
          "query",
          "total_matches"
        ],
        "title": "SearchDocumentsResponse"
      },
      "SearchKnowledgeRequest": {
        "properties": {
          "query": {
            "type": "string",
            "title": "Query",
            "description": "Natural language search query",
            "example": "What is the attendance requirement for B.Tech students?"
          },
          "department": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Department",
            "description": "Optional department filter",
            "example": "Academic Admin Office"
          },
          "document_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Document Type",
            "description": "Optional file type filter ('pdf', 'docx', 'xlsx')",
            "example": "pdf"
          },
          "academic_year": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Academic Year",
            "description": "Optional academic year filter",
            "example": "2023"
          },
          "role": {
            "type": "string",
            "title": "Role",
            "description": "Role for access control ('public', 'student', 'faculty', 'admin')",
            "default": "student",
            "example": "student"
          },
          "top_k": {
            "type": "integer",
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Top K",
            "description": "Number of verified candidate chunks to return",
            "default": 5,
            "example": 5
          }
        },
